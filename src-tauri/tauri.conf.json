{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SharkDeck",
  "version": "0.1.0",
  "identifier": "io.github.gestion-empresaurios-2.sharkdeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SharkDeck",
        "width": 1220,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 660,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Screen, knob, lighting and keymap control for the Attack Shark K86",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "REPLACE_WITH_YOUR_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/Gestion-Empresaurios-2/sharkdeck/releases/latest/download/latest.json"
      ]
    }
  }
}
